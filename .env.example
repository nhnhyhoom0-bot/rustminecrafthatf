# GEMINI_API_KEY: Unused in RustCraft.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# CURSEFORGE_API_KEY: Optional API key for live CurseForge v1 mod searches.
# Configure via the Secrets panel in AI Studio.
CURSEFORGE_API_KEY=YOUR_CURSEFORGE_API_KEY

# MICROSOFT_CLIENT_ID: Azure App Client ID for Microsoft OAuth2 Device Code Minecraft login.
# Configure via the Secrets panel in AI Studio.
MICROSOFT_CLIENT_ID=YOUR_AZURE_APP_CLIENT_ID
